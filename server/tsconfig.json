{
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": [ "ES2023", "DOM", "ES2022" ],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "pretty": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [ "node" ],
    "paths": {
      "@/*": [ "./src/*" ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [ "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts" ],
  "exclude": [ "node_modules", "dist" ]
}