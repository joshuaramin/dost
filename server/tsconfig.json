{
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "jsx": "react-jsx",

    "noEmit": true,
    "lib": [ "ES2023" ],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "pretty": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": [ "./src/*" ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [ "src", "src/lib/prisma/system/prisma.config.ts" ]
}
