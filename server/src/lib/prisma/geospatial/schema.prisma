generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["geo"]
}

model municipalities {
  ogc_fid   Int                      @id @default(autoincrement())
  geom      Unsupported("geometry")?
  gid_2     String?                  @db.VarChar
  gid_0     String?                  @db.VarChar
  country   String?                  @db.VarChar
  gid_1     String?                  @db.VarChar
  name_1    String?                  @db.VarChar
  nl_name_1 String?                  @db.VarChar
  name_2    String?                  @db.VarChar
  varname_2 String?                  @db.VarChar
  nl_name_2 String?                  @db.VarChar
  type_2    String?                  @db.VarChar
  engtype_2 String?                  @db.VarChar
  cc_2      String?                  @db.VarChar
  hasc_2    String?                  @db.VarChar

  @@index([geom], map: "municipalities_geom_geom_idx", type: Gist)
  @@index([gid_0], map: "idx_municipalities_country")
  @@index([geom], map: "idx_municipalities_geom", type: Gist)
  @@index([geom], map: "idx_municipalities_geom_gist", type: Gist)
  @@index([gid_1, gid_2], map: "idx_municipalities_gid1_gid2")
  @@index([gid_1], map: "idx_municipalities_gid_1")
  @@index([name_2], map: "idx_municipalities_name_2")
  @@schema("geo")
}

model provinces {
  ogc_fid   Int                      @id @default(autoincrement())
  geom      Unsupported("geometry")?
  gid_1     String?                  @db.VarChar
  gid_0     String?                  @db.VarChar
  country   String?                  @db.VarChar
  name_1    String?                  @db.VarChar
  varname_1 String?                  @db.VarChar
  nl_name_1 String?                  @db.VarChar
  type_1    String?                  @db.VarChar
  engtype_1 String?                  @db.VarChar
  cc_1      String?                  @db.VarChar
  hasc_1    String?                  @db.VarChar
  iso_1     String?                  @db.VarChar

  @@index([geom], map: "provinces_geom_geom_idx", type: Gist)
  @@index([gid_0], map: "idx_provinces_country")
  @@index([geom], map: "idx_provinces_geom", type: Gist)
  @@index([geom], map: "idx_provinces_geom_gist", type: Gist)
  @@index([gid_1, name_1], map: "idx_provinces_gid1_name")
  @@index([gid_1], map: "idx_provinces_gid_1")
  @@index([name_1], map: "idx_provinces_name_1")
  @@schema("geo")
}

model regions {
  id             BigInt                   @id @default(autoincrement())
  psgc_code      String                   @unique @db.Char(2)
  full_psgc_code String                   @unique @db.Char(10)
  region_code    String                   @unique @db.VarChar(20)
  region_name    String                   @unique @db.VarChar(255)
  short_name     String?                  @db.VarChar(100)
  island_group   String?                  @db.VarChar(50)
  geom           Unsupported("geometry")?
  area_sqkm      Decimal?                 @default(dbgenerated("\nCASE\n    WHEN (geom IS NOT NULL) THEN (st_area((geom)::geography) / (1000000)::double precision)\n    ELSE NULL::double precision\nEND")) @db.Decimal(18, 2)
  created_at     DateTime?                @default(now()) @db.Timestamp(6)
  updated_at     DateTime?                @default(now()) @db.Timestamp(6)

  @@index([psgc_code], map: "idx_regions_psgc_code")
  @@schema("geo")
}

model barangays {
  ogc_fid   Int                      @id @default(autoincrement())
  geom      Unsupported("geometry")?
  gid_3     String?                  @db.VarChar
  gid_0     String?                  @db.VarChar
  country   String?                  @db.VarChar
  gid_1     String?                  @db.VarChar
  name_1    String?                  @db.VarChar
  nl_name_1 String?                  @db.VarChar
  gid_2     String?                  @db.VarChar
  name_2    String?                  @db.VarChar
  nl_name_2 String?                  @db.VarChar
  name_3    String?                  @db.VarChar
  varname_3 String?                  @db.VarChar
  nl_name_3 String?                  @db.VarChar
  type_3    String?                  @db.VarChar
  engtype_3 String?                  @db.VarChar
  cc_3      String?                  @db.VarChar
  hasc_3    String?                  @db.VarChar

  @@index([geom], map: "barangays_geom_geom_idx", type: Gist)
  @@index([geom], map: "idx_barangay_geom", type: Gist)
  @@index([geom], map: "idx_barangay_geom_gist", type: Gist)
  @@index([gid_2, gid_3], map: "idx_barangay_gid2_gid3")
  @@index([gid_1], map: "idx_barangay_gid_1")
  @@index([gid_2], map: "idx_barangay_gid_2")
  @@index([gid_3], map: "idx_barangay_gid_3")
  @@index([name_3], map: "idx_barangay_name_3")
  @@schema("geo")
}
