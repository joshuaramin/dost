generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["geo"]
}

enum TreatmentHubStatus {
  ACTIVE
  INACTIVE
  CLOSED

  @@schema("geo")
}

model treatment_hubs {
  treatment_hub_id String @id @default(cuid())

  code String? @unique

  name String
  slug String @unique

  description String? @db.Text

  address String?

  contact_number String?

  email String?

  website String?

  operating_hours String?

  latitude Float?

  longitude Float?

  geom Unsupported("geometry(Point,4326)")?

  region_id Int?

  province_ogc_fid Int?

  municipality_ogc_fid Int?

  barangay_ogc_fid Int?

  is_deleted Boolean @default(false)

  status TreatmentHubStatus @default(ACTIVE)

  regions regions? @relation(fields: [region_id], references: [region_id])

  provinces provinces? @relation(fields: [province_ogc_fid], references: [ogc_fid])

  municipalities municipalities? @relation(fields: [municipality_ogc_fid], references: [ogc_fid])

  barangays barangays? @relation(fields: [barangay_ogc_fid], references: [ogc_fid])

  services treatment_hub_services[]

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  @@index([geom], type: Gist)
  @@schema("geo")
}

model services {
  service_id String @id @default(cuid())

  name String @unique

  description String?
  is_deleted  Boolean @default(false) @db.Boolean

  hubs treatment_hub_services[]

  @@schema("geo")
}

model treatment_hub_services {
  treatment_hub_services_id String          @id @default(cuid())
  treatmentHubs             treatment_hubs? @relation(fields: [treatment_hubs_id], references: [treatment_hub_id])
  treatment_hubs_id         String?
  services                  services?       @relation(fields: [service_id], references: [service_id])
  service_id                String?

  @@schema("geo")
}

model municipalities {
  ogc_fid       Int                      @id @default(autoincrement())
  geom          Unsupported("geometry")?
  gid_2         String?                  @unique(map: "municipalities_name_unique") @db.VarChar
  gid_0         String?                  @db.VarChar
  country       String?                  @db.VarChar
  gid_1         String?                  @db.VarChar
  name_1        String?                  @db.VarChar
  nl_name_1     String?                  @db.VarChar
  name_2        String?                  @db.VarChar
  varname_2     String?                  @db.VarChar
  nl_name_2     String?                  @db.VarChar
  type_2        String?                  @db.VarChar
  engtype_2     String?                  @db.VarChar
  cc_2          String?                  @db.VarChar
  hasc_2        String?                  @db.VarChar
  barangays     barangays[]
  provinces     provinces?               @relation(fields: [name_1], references: [name_1], onDelete: Restrict, map: "fk_municipalities_province_name")
  treatmentHubs treatment_hubs[]

  @@index([geom], map: "municipalities_geom_geom_idx", type: Gist)
  @@schema("geo")
}

model provinces {
  ogc_fid           Int                      @id @default(autoincrement())
  gid_1             String?                  @unique(map: "provinces_gid1_unique") @db.VarChar
  gid_0             String?                  @db.VarChar
  country           String?                  @db.VarChar
  name_1            String?                  @unique(map: "provinces_name_unique") @db.VarChar
  varname_1         String?                  @db.VarChar
  nl_name_1         String?                  @db.VarChar
  type_1            String?                  @db.VarChar
  engtype_1         String?                  @db.VarChar
  cc_1              String?                  @db.VarChar
  hasc_1            String?                  @db.VarChar
  iso_1             String?                  @db.VarChar
  geom              Unsupported("geometry")?
  municipalities    municipalities[]
  regions_provinces regions_provinces[]
  treatmentHubs     treatment_hubs[]

  @@index([geom], map: "provinces_geom_geom_idx", type: Gist)
  @@schema("geo")
}

model regions {
  region_id         Int                      @id @default(autoincrement())
  psgc_code         String?                  @unique @db.VarChar(20)
  name              String
  geom              Unsupported("geometry")?
  regions_provinces regions_provinces[]
  treatmentHubs     treatment_hubs[]

  @@schema("geo")
}

model barangays {
  ogc_fid        Int                      @id @default(autoincrement())
  geom           Unsupported("geometry")?
  gid_3          String?                  @db.VarChar
  gid_0          String?                  @db.VarChar
  country        String?                  @db.VarChar
  gid_1          String?                  @db.VarChar
  name_1         String?                  @db.VarChar
  nl_name_1      String?                  @db.VarChar
  gid_2          String?                  @db.VarChar
  name_2         String?                  @db.VarChar
  nl_name_2      String?                  @db.VarChar
  name_3         String?                  @db.VarChar
  varname_3      String?                  @db.VarChar
  nl_name_3      String?                  @db.VarChar
  type_3         String?                  @db.VarChar
  engtype_3      String?                  @db.VarChar
  cc_3           String?                  @db.VarChar
  hasc_3         String?                  @db.VarChar
  municipalities municipalities?          @relation(fields: [gid_2], references: [gid_2], onDelete: Restrict, map: "fk_barangays_municipality")
  treatmentHubs  treatment_hubs[]

  @@index([geom], map: "barangays_geom_geom_idx", type: Gist)
  @@schema("geo")
}

model regions_provinces {
  id               Int       @id @default(autoincrement())
  region_psgc_code String    @db.VarChar(20)
  province_ogc_fid Int
  provinces        provinces @relation(fields: [province_ogc_fid], references: [ogc_fid], map: "fk_rp_province")
  regions          regions   @relation(fields: [region_psgc_code], references: [psgc_code], map: "fk_rp_region")

  @@unique([region_psgc_code, province_ogc_fid], map: "uq_region_province")
  @@schema("geo")
}
