generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id           String              @id @default(cuid())
  email             String              @unique @db.VarChar(255)
  is_deleted        Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  role_id           String?
  organization_id   String?
  ActivityLog       ActivityLog[]
  DeviceSession     DeviceSession[]
  EducationResource EducationResource[]
  Notification      Notification[]
  OTP               OTP[]
  Profile           Profile?
  organization      Organization?       @relation(fields: [organization_id], references: [organization_id])
  role              Role?               @relation(fields: [role_id], references: [role_id])

  @@index([role_id])
  @@index([is_deleted])
  @@index([created_at])
}

model OTP {
  otp_id       String   @id @default(cuid())
  identifier   String   @default("email") @db.VarChar(255)
  type         String   @default("login")
  expires_at   DateTime
  is_used      Boolean  @default(false)
  attempts     Int      @default(0)
  max_attempts Int      @default(5)
  ip_address   String?  @db.VarChar(100)
  user_agent   String?
  user_id      String?
  created_at   DateTime @default(now())
  code_hash    String   @db.VarChar(255)
  user         User?    @relation(fields: [user_id], references: [user_id])

  @@index([identifier, type])
  @@index([expires_at])
}

model Profile {
  profile_id String   @id @default(cuid())
  first_name String
  last_name  String
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user_id    String   @unique
  User       User     @relation(fields: [user_id], references: [user_id])
}

model Resource {
  resource_id String       @id @default(cuid())
  name        String       @unique @db.VarChar(100)
  slug        String       @unique
  parent_id   String?
  is_deleted  Boolean      @default(false)
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  updated_at  DateTime     @default(now()) @updatedAt @db.Timestamp(6)
  order       Int
  permissions Permission[]
  parent      Resource?    @relation("ResourceHeirarchy", fields: [parent_id], references: [resource_id])
  children    Resource[]   @relation("ResourceHeirarchy")

  @@index([is_deleted])
  @@index([created_at])
}

model Role {
  role_id         String           @id @default(cuid())
  name            String           @unique @db.VarChar(100)
  description     String?
  is_deleted      Boolean          @default(false)
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  slug            String           @unique
  rolePermissions RolePermission[]
  users           User[]

  @@index([is_deleted])
  @@index([created_at])
}

model Permission {
  permission_id   String           @id @default(cuid())
  is_deleted      Boolean          @default(false)
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  resource_id     String?
  name            String           @db.VarChar(100)
  slug            String
  resource        Resource?        @relation(fields: [resource_id], references: [resource_id])
  rolePermissions RolePermission[]

  @@index([is_deleted])
  @@index([created_at])
}

model RolePermission {
  role_permission_id String     @id @default(cuid())
  role_id            String
  permission_id      String
  Permission         Permission @relation(fields: [permission_id], references: [permission_id])
  role               Role       @relation(fields: [role_id], references: [role_id])

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
}

model ActivityLog {
  activity_logs_id String   @id @default(cuid())
  type             String   @db.VarChar(50)
  decription       String?  @db.VarChar(100)
  is_deleted       Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user_id          String?
  user             User?    @relation(fields: [user_id], references: [user_id])
}

model Notification {
  notification_id String   @id @default(cuid())
  title           String
  is_deleted      Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user_id         String?
  user            User?    @relation(fields: [user_id], references: [user_id])
}

model Organization {
  organization_id String   @id @default(cuid())
  name            String   @db.VarChar(100)
  is_deleted      Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)
  address         String?
  contact         String
  logo            String
  User            User[]
}

model DeviceSession {
  device_sessions_id String   @id @default(cuid())
  device_name        String   @db.VarChar(100)
  ip_address         String   @db.VarChar(100)
  expired_at         DateTime
  is_deleted         Boolean  @default(false)
  is_revoked         Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user_id            String?
  browser            String
  device_type        String
  os                 String
  user_agent         String
  user               User?    @relation(fields: [user_id], references: [user_id])
}

model EducationAttachment {
  education_attachment_id String            @id @default(cuid())
  education_resource_id   String
  type                    AttachmentType
  file_name               String            @db.VarChar(255)
  file_url                String
  mime_type               String?           @db.VarChar(100)
  file_size               Int?
  order_index             Int               @default(0)
  created_at              DateTime          @default(now()) @db.Timestamp(6)
  resource                EducationResource @relation(fields: [education_resource_id], references: [education_resource_id], onDelete: Cascade)

  @@index([education_resource_id])
}

model EducationTag {
  education_tag_id String                 @id @default(cuid())
  name             String                 @unique @db.VarChar(50)
  slug             String                 @unique
  resources        EducationResourceTag[]

  @@index([name])
}

model EducationResourceTag {
  education_resource_id String
  education_tag_id      String
  resource              EducationResource @relation(fields: [education_resource_id], references: [education_resource_id], onDelete: Cascade)
  tag                   EducationTag      @relation(fields: [education_tag_id], references: [education_tag_id], onDelete: Cascade)

  @@id([education_resource_id, education_tag_id])
}

model EducationCategory {
  education_category_id String              @id @default(cuid())
  name                  String              @unique @db.VarChar(100)
  slug                  String              @unique
  description           String?             @db.VarChar(300)
  parent_id             String?
  is_deleted            Boolean             @default(false)
  created_at            DateTime            @default(now()) @db.Timestamp(6)
  updated_at            DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  parent                EducationCategory?  @relation("EducationCategoryHierarchy", fields: [parent_id], references: [education_category_id])
  children              EducationCategory[] @relation("EducationCategoryHierarchy")
  resources             EducationResource[]

  @@index([parent_id])
  @@index([is_deleted])
}

model EducationResource {
  education_resource_id String                 @id @default(cuid())
  title                 String                 @db.VarChar(255)
  content               String?
  is_deleted            Boolean                @default(false)
  created_at            DateTime               @default(now()) @db.Timestamp(6)
  updated_at            DateTime               @default(now()) @updatedAt @db.Timestamp(6)
  user_id               String?
  external_link         String?
  slug                  String                 @unique
  category_id           String
  is_featured           Boolean                @default(false)
  published_at          DateTime?
  status                EducationStatus        @default(DRAFT)
  summary               String?                @db.VarChar(500)
  thumbnail             String?
  type                  EducationResourceType
  attachments           EducationAttachment[]
  category              EducationCategory      @relation(fields: [category_id], references: [education_category_id])
  user                  User?                  @relation(fields: [user_id], references: [user_id])
  tags                  EducationResourceTag[]

  @@index([title])
  @@index([slug])
  @@index([category_id])
  @@index([user_id])
  @@index([type])
  @@index([status])
  @@index([published_at])
}

model Survey {
  survey_id    String           @id @default(cuid())
  title        String           @db.VarChar(100)
  description  String?          @db.VarChar(300)
  is_deleted   Boolean          @default(false)
  created_at   DateTime         @default(now()) @db.Timestamp(6)
  updated_at   DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  slug         String           @unique
  is_published Boolean          @default(false)
  questions    SurveyQuestion[]
  responses    SurveyResponse[]
}

model SurveyQuestion {
  survey_question_id String           @id @default(cuid())
  survey_id          String
  text               String           @db.VarChar(300)
  type               SurveyType
  is_required        Boolean          @default(false)
  order_index        Int              @default(0)
  is_deleted         Boolean          @default(false)
  created_at         DateTime         @default(now()) @db.Timestamp(6)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  options            QuestionOption[]
  answers            SurveyAnswer[]
  survey             Survey           @relation(fields: [survey_id], references: [survey_id], onDelete: Cascade)

  @@index([survey_id])
}

model QuestionOption {
  question_option_id String               @id @default(cuid())
  survey_question_id String
  label              String               @db.VarChar(300)
  value              String               @db.VarChar(300)
  order_index        Int                  @default(0)
  is_deleted         Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  question           SurveyQuestion       @relation(fields: [survey_question_id], references: [survey_question_id], onDelete: Cascade)
  answers            SurveyAnswer[]
  selected_options   SurveyAnswerOption[]

  @@index([survey_question_id])
}

model SurveyResponse {
  response_id String         @id @default(cuid())
  survey_id   String
  created_at  DateTime       @default(now()) @db.Timestamp(6)
  answers     SurveyAnswer[]
  survey      Survey         @relation(fields: [survey_id], references: [survey_id], onDelete: Cascade)

  @@index([survey_id])
}

model SurveyAnswer {
  answer_id          String               @id @default(cuid())
  survey_response_id String
  survey_question_id String
  answer_text        String?
  answer_option_id   String?
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  option             QuestionOption?      @relation(fields: [answer_option_id], references: [question_option_id], onDelete: Cascade)
  question           SurveyQuestion       @relation(fields: [survey_question_id], references: [survey_question_id], onDelete: Cascade)
  response           SurveyResponse       @relation(fields: [survey_response_id], references: [response_id], onDelete: Cascade)
  selected_options   SurveyAnswerOption[]

  @@index([survey_response_id])
  @@index([survey_question_id])
  @@index([answer_option_id])
}

model SurveyAnswerOption {
  survey_answer_option_id String         @id @default(cuid())
  survey_answer_id        String
  question_option_id      String
  created_at              DateTime       @default(now()) @db.Timestamp(6)
  updated_at              DateTime       @default(now()) @updatedAt @db.Timestamp(6)
  option                  QuestionOption @relation(fields: [question_option_id], references: [question_option_id], onDelete: Cascade)
  answer                  SurveyAnswer   @relation(fields: [survey_answer_id], references: [answer_id], onDelete: Cascade)

  @@unique([survey_answer_id, question_option_id])
  @@index([survey_answer_id])
  @@index([question_option_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum EducationResourceType {
  ARTICLE
  VIDEO
  DOCUMENT
  CATALOGUE
  INFOGRAPHIC
  WEBINAR
  PODCAST
  EXTERNAL_LINK
}

enum EducationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttachmentType {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
  AUDIO
  OTHER
}

enum SurveyType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  CHECKBOX
}
